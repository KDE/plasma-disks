#: instabilities.cpp:27
#, kde-format
msgctxt "@label"
msgid "Prefail attributes <= threshold."
msgstr "Atributi pred krahom na pragu ili ispod njega."

#: instabilities.cpp:31
#, kde-format
msgctxt "@label"
msgid ""
"SMART status check returned 'DISK OK' but we found that some (usage or "
"prefail) attributes have been <= threshold at some time in the past."
msgstr ""
"Provjera SMART stanja vratila je „DISK OK“, ali je nađeno da su neki "
"atributi (upotrebe ili pred krahom) u nekom trenutku u prošlosti bili na "
"pragu ili ispod njega."

#: instabilities.cpp:33
#, kde-format
msgctxt "@label"
msgid "The device error log contains records of errors."
msgstr "Dnevnik grešaka uređaja sadrži zapise o greškama."

#: instabilities.cpp:37
#, kde-format
msgctxt "@label"
msgid ""
"The device self-test log contains records of errors. [ATA only] Failed self-"
"tests outdated by a newer successful extended self-test are ignored."
msgstr ""
"Dnevnik samoproba uređaja sadrži zapise o greškama. [Samo ATA] Neuspjele "
"samoprobe koje je prevazišla novija uspješna proširena samoproba se ignorišu."

#: kcm/ui/main.qml:36
msgctxt "@action/button action button to start partition manager"
msgid "Open Partition Manager"
msgstr "Otvori menadžer particija"

#: kcm/ui/main.qml:42
msgctxt "@action/button action button to start backup program"
msgid "Perform Backup"
msgstr "Napravi rezervu"

#: kcm/ui/main.qml:62
msgctxt "@info/status"
msgid "Unable to obtain data. KDED is not running."
msgstr "Ne mogu da dobavim podatke. KDED nije pokrenut."

#: kcm/ui/main.qml:73
msgctxt "@info/status"
msgid "No S.M.A.R.T. devices found."
msgstr "Nije nađen nijedan SMART uređaj."

#: kcm/ui/main.qml:95
msgctxt "@info"
msgid ""
"The SMART system of this device is reporting problems. This may be a sign of "
"imminent device failure or data reliability being compromised. Back up your "
"data and replace this drive as soon as possible to avoid losing any data."
msgstr ""
"SMART sistem ovog uređaja prijavljuje probleme. Ovo može biti znak skorog "
"otkaza uređaja ili ugrožene pouzdanosti podataka. Napravite rezervu podataka "
"i zamijenite ovu jedinicu što prije, da ne biste izgubili podatke."

#: kcm/ui/main.qml:101
msgctxt "@info %1 is a bunch of <li> with the strings from instabilities.cpp"
msgid ""
"<p>The SMART firmware is not reporting a failure, but there are early signs "
"of malfunction. This might not point at imminent device failure but requires "
"longer term analysis. Back up your data and contact the manufacturer of this "
"disk, or replace it preemptively just to be safe.</p><ul>%1</ul>"
msgstr ""
"<p>SMART firmver ne prijavljuje otkaz, ali postoje rani znaci kvara. Ovo "
"možda ne ukazuje na skori otkaz uređaja, ali zahtijeva dugoročniju analizu. "
"Napravite rezervu podataka i obratite se proizvođaču ovog diska, ili ga "
"unaprijed zamijenite, za svaki slučaj.</p><ul>%1</ul>"

#: kcm/ui/main.qml:107
msgctxt "@info"
msgid "This device appears to be working as expected."
msgstr "Izgleda da ovaj uređaj radi kako se očekuje."

#: kcm/ui/main.qml:114
msgctxt "@action/button action button to monitor a device for smart failure"
msgid "Monitor"
msgstr "Nadgledaj"

#: kcm/ui/main.qml:115
msgctxt "@action/button action button to ignore smart failures for a device"
msgid "Ignore"
msgstr "Ignoriši"

#: kcm/ui/main.qml:123
msgctxt "@action/button show detailed smart report"
msgid "Show Details"
msgstr "Prikaži detalje"

#: kcm/ui/ReportPage.qml:24
msgctxt "@action:button copies all displayed text"
msgid "Copy to Clipboard"
msgstr "Kopiraj u klipbord"

#: smartctl.cpp:33
#, kde-format
msgctxt ""
"@label description of authentication request to read SMART data. %1 is a "
"device path e.g. /dev/sda"
msgid "Read SMART report for storage device %1"
msgstr "Čitanje SMART izvještaja skladišnog uređaja %1"

#: smartnotifier.cpp:29
#, kde-format
msgctxt "@title notification"
msgid "Storage Device Problems"
msgstr "Problemi skladišnog uređaja"

#: smartnotifier.cpp:32
#, kde-kuit-format
msgctxt ""
"@info notification; text %1 is a pretty product name; %2 the device path e."
"g. /dev/sda"
msgid ""
"The storage device <emphasis>%1</emphasis> (<filename>%2</filename>) is "
"likely to fail soon!"
msgstr ""
"Skladišni uređaj <emphasis>%1</emphasis> (<filename>%2</filename>) će "
"vjerovatno uskoro otkazati!"

#: smartnotifier.cpp:37
#, kde-kuit-format
msgctxt ""
"@info notification; text %1 is a pretty product name; %2 the device path e."
"g. /dev/sda"
msgid ""
"The storage device <emphasis>%1</emphasis> (<filename>%2</filename>) is "
"showing indications of instability."
msgstr ""
"Skladišni uređaj <emphasis>%1</emphasis> (<filename>%2</filename>) pokazuje "
"znake nestabilnosti."

#: smartnotifier.cpp:44
#, kde-format
msgctxt "@action:button notification action to manage device problems"
msgid "Manage"
msgstr "Upravljaj"
