#: instabilities.cpp:27
#, kde-format
msgctxt "@label"
msgid "Prefail attributes <= threshold."
msgstr "كاشىلىدىن ئىلگىرىكى خاسلىقى بوسۇغا قىممىتىدىن كىچىك ياكى تەڭ."

#: instabilities.cpp:31
#, kde-format
msgctxt "@label"
msgid ""
"SMART status check returned 'DISK OK' but we found that some (usage or "
"prefail) attributes have been <= threshold at some time in the past."
msgstr ""
"SMART ھالىتىنى تەكشۈرۈش «DISK OK»  يەنى دىسكا ياخشى ئۇچۇرىنى قايتۇردى ئەمما "
"بەزى (ئىشلىتىش ياكى مەغلۇپ بولۇشتىن ئىلگىرى) خاسلىق قىممىتى بوسۇغا "
"قىممىتىدىن كىچىك ياكى تەڭ ئىكەنلىكىنى بايقىدى."

#: instabilities.cpp:33
#, kde-format
msgctxt "@label"
msgid "The device error log contains records of errors."
msgstr "ئۈسكۈنىنىڭ خاتالىق كۈندىلىك خاتىرىسىدە خاتا خاتىرە بار."

#: instabilities.cpp:37
#, kde-format
msgctxt "@label"
msgid ""
"The device self-test log contains records of errors. [ATA only] Failed self-"
"tests outdated by a newer successful extended self-test are ignored."
msgstr ""
"ئۈسكۈنىنىڭ ئۆزىنى تەكشۈرۈش كۈندىلىك خاتىرىسىدە خاتا خاتىرە بار. [ATA لا] "
"مۇۋەپپەقىيەتلىك ئۆزىنى تەكشۈرۈش يۈز بېرىشتىن ئىلگىرىكى ئۆزىنى تەكشۈرۈش "
"مەغلۇبىيىتىگە پەرۋا قىلمايدۇ."

#: kcm/ui/main.qml:36
msgctxt "@action/button action button to start partition manager"
msgid "Open Partition Manager"
msgstr "دىسكا رايونى باشقۇرغۇچنى ئاچ"

#: kcm/ui/main.qml:42
msgctxt "@action/button action button to start backup program"
msgid "Perform Backup"
msgstr "زاپاسلاشنى ئىجرا قىل"

#: kcm/ui/main.qml:62
msgctxt "@info/status"
msgid "Unable to obtain data. KDED is not running."
msgstr "سانلىق مەلۇماتقا ئېرىشەلمىدى. KDED ئىجرا قىلىنمايۋاتىدۇ."

#: kcm/ui/main.qml:73
msgctxt "@info/status"
msgid "No S.M.A.R.T. devices found."
msgstr "ھېچقانداق S.M.A.R.T. ئۈسكۈنىسى تېپىلمىدى."

#: kcm/ui/main.qml:95
msgctxt "@info"
msgid ""
"The SMART system of this device is reporting problems. This may be a sign of "
"imminent device failure or data reliability being compromised. Back up your "
"data and replace this drive as soon as possible to avoid losing any data."
msgstr ""
"بۇ ئۈسكۈنىنىڭ SMART سىستېمىسى مەسىلە مەلۇم قىلىۋاتىدۇ. بۇ ئۈسكۈنە مەسىلىسى "
"ياكى سانلىق مەلۇمات ئىشەنچلىكلىكىنىڭ زىيانغا ئۇچرىغانلىقىنىڭ بېشارىتى بولۇشى "
"مۇمكىن. سانلىق مەلۇماتنىڭ بۇزۇلۇشىنىڭ ئالدىنى ئېلىش ئۈچۈن، ئامالنىڭ بارىچە "
"بۇ ئۈسكۈنىدىكى سانلىق مەلۇماتنى زاپاسلاپ، مەزكۇر ئۈسكۈنىنى ئالماشتۇرۇڭ."

#: kcm/ui/main.qml:101
msgctxt "@info %1 is a bunch of <li> with the strings from instabilities.cpp"
msgid ""
"<p>The SMART firmware is not reporting a failure, but there are early signs "
"of malfunction. This might not point at imminent device failure but requires "
"longer term analysis. Back up your data and contact the manufacturer of this "
"disk, or replace it preemptively just to be safe.</p><ul>%1</ul>"
msgstr ""
"<p>SMART مۇقىم دېتالى مەسىلىنى مەلۇم قىلمىدى ئەمما بۇ ئۈسكۈنىدە مەسىلە "
"كۆرۈلگەنلىكنىڭ ئالامىتى كۆرۈلدى. بۇ مەزكۇر ئۈسكۈنىدە تېزلا كاشىلا يۈز "
"بېرىدىغانلىقىدىن دېرەك بەرمەيدۇ ئەمما ئۈسكۈنىنى ئۇزۇن مۇددەت ئىشلىتىش ياكى "
"ئىشلەتمەسلىكنى تەھلىل قىلىش كېرەك. سانلىق مەلۇماتنىڭ بىخەتەرلىكىگە "
"كاپالەتلىك قىلىش ئۈچۈن سانلىق مەلۇماتنى زاپاسلاپ ۋە زاۋۇت بىلەن ئالاقىلىشىڭ "
"ياكى ئالدىنى ئېلىش خاراكتېرلىك ئۈسكۈنە ئالماشتۇرۇڭ.</p><ul>%1</ul>"

#: kcm/ui/main.qml:107
msgctxt "@info"
msgid "This device appears to be working as expected."
msgstr "بۇ ئۈسكۈنە مۆلچەردىكىدەك ئىشلەۋاتقاندەك قىلىدۇ."

#: kcm/ui/main.qml:114
msgctxt "@action/button action button to monitor a device for smart failure"
msgid "Monitor"
msgstr "ئېكران"

#: kcm/ui/main.qml:115
msgctxt "@action/button action button to ignore smart failures for a device"
msgid "Ignore"
msgstr "پەرۋا قىلما"

#: kcm/ui/main.qml:123
msgctxt "@action/button show detailed smart report"
msgid "Show Details"
msgstr "تەپسىلاتىنى كۆرسەت"

#: kcm/ui/ReportPage.qml:24
msgctxt "@action:button copies all displayed text"
msgid "Copy to Clipboard"
msgstr "چاپلاش تاختىسىغا كۆچۈر"

#: smartctl.cpp:33
#, kde-format
msgctxt ""
"@label description of authentication request to read SMART data. %1 is a "
"device path e.g. /dev/sda"
msgid "Read SMART report for storage device %1"
msgstr "ساقلاش ئۈسكۈنىسى %1 نىڭ SMART دوكلاتىنى ئوقۇيدۇ"

#: smartnotifier.cpp:29
#, kde-format
msgctxt "@title notification"
msgid "Storage Device Problems"
msgstr "ساقلىغۇچ ئۈسكۈنە مەسىلىسى"

#: smartnotifier.cpp:32
#, kde-kuit-format
msgctxt ""
"@info notification; text %1 is a pretty product name; %2 the device path e."
"g. /dev/sda"
msgid ""
"The storage device <emphasis>%1</emphasis> (<filename>%2</filename>) is "
"likely to fail soon!"
msgstr ""
"ساقلىغۇچ ئۈسكۈنىسى <emphasis>%1</emphasis> (<filename>%2</filename>) پات "
"يېقىندا بۇزۇلىدىغاندەك قىلىدۇ!"

#: smartnotifier.cpp:37
#, kde-kuit-format
msgctxt ""
"@info notification; text %1 is a pretty product name; %2 the device path e."
"g. /dev/sda"
msgid ""
"The storage device <emphasis>%1</emphasis> (<filename>%2</filename>) is "
"showing indications of instability."
msgstr ""
"ساقلىغۇچ ئۈسكۈنىسى <emphasis>%1</emphasis> (<filename>%2</filename>) دا "
"مۇقىمسىزلىق ئالامىتى كۆرۈلدى."

#: smartnotifier.cpp:44
#, kde-format
msgctxt "@action:button notification action to manage device problems"
msgid "Manage"
msgstr "باشقۇر"
